# Host directory holding the bind-mounted volumes (macOS home is /Users, not /home).
# `make up` creates the mariadb/ and wordpress/ sub-directories before starting.
DATA_PATH=/Users/ubuntu/Desktop/data

# MariaDB (used by mariadb/tools/script.sh and wordpress/tools/script.sh)
MYSQL_DATABASE=wordpress
mariadb_USER=wp_dbuser
mariadb_PASSWORD=wp_dbpass
mariadb_ROOT_PASSWORD=db_root_pass

# WordPress site
DOMAIN_NAME=aarchtou.42.fr
TITLE=Inception

# WordPress administrator account
MYSQL_ROOT_USER=aarchtou
MYSQL_ROOT_PASSWORD=root_pass

# WordPress second (author) account
MYSQL_USER=wp_user
MYSQL_PASSWORD=wp_pass
